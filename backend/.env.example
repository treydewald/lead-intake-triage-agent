APP_NAME="Lead Intake Triage Agent API"
ENVIRONMENT=development

# SQLite by default (zero-config). Swap for a PostgreSQL DSN in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/lead_intake
DATABASE_URL=sqlite:///./leads.db

# Local open-weight LLM via Ollama (default classification/enrichment path — must be
# running locally: `ollama serve`, with OLLAMA_MODEL pulled).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional hosted-LLM fallback (only if local tool-calling proves insufficiently
# reliable — see project-definition.md's Assumptions). Leave unset by default.
FALLBACK_LLM_API_KEY=

# HubSpot free-tier developer sandbox — create a Private App in your sandbox account
# (Settings > Integrations > Private Apps) with crm.objects.contacts scope, and paste
# its access token here. Never commit a real token.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_BASE_URL=https://api.hubapi.com

CONFIDENCE_THRESHOLD=0.7

CORS_ORIGINS=["http://localhost:5173"]

# Optional Slack-compatible incoming webhook URL for external delivery of
# awaiting_review notifications (Feature 10). Leave unset by default - a review
# notification always still appears in-app via GET /notifications either way.
NOTIFICATION_WEBHOOK_URL=
